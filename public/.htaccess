# ----------------------------------------------------------------------
# Freya Trading — Apache config for a Vite + React (SPA) build
# ----------------------------------------------------------------------

# --- Single Page App routing -----------------------------------------
# Send every request that is NOT a real file or directory to index.html
# so React Router can handle client-side routes (e.g. /about, /contact).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If an existing file or directory is requested, serve it as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, hand the request to index.html.
  RewriteRule ^ index.html [L]
</IfModule>

# --- Force HTTPS (uncomment after SSL is installed) ------------------
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# --- Compression ------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/wasm
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# --- Browser caching --------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: always revalidate so users get the latest deploy.
  ExpiresByType text/html "access plus 0 seconds"

  # Hashed assets (JS/CSS) can be cached aggressively.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"

  # Images, fonts and media.
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
</IfModule>

# Never cache index.html (so route/asset references stay fresh).
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Security headers -------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Misc -------------------------------------------------------------
# Disable directory listing.
Options -Indexes

# Use index.html as the default document.
DirectoryIndex index.html
